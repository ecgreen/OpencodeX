{
  "$schema": "./policy.schema.json",
  "version": 1,
  "retainedWorkspaces": [
    { "path": "packages/opencode", "name": "opencode" },
    { "path": "packages/core", "name": "@opencode-ai/core" },
    { "path": "packages/gui", "name": "@opencode-ai/gui" },
    { "path": "packages/sdk/js", "name": "@opencode-ai/sdk" },
    { "path": "packages/ui", "name": "@opencode-ai/ui" },
    { "path": "packages/plugin", "name": "@opencode-ai/plugin" },
    { "path": "packages/llm", "name": "@opencode-ai/llm" },
    { "path": "packages/script", "name": "@opencode-ai/script" },
    { "path": "packages/effect-drizzle-sqlite", "name": "@opencode-ai/effect-drizzle-sqlite" },
    { "path": "packages/effect-sqlite-node", "name": "@opencode-ai/effect-sqlite-node" },
    { "path": "packages/http-recorder", "name": "@opencode-ai/http-recorder" },
    { "path": "github", "name": "github" }
  ],
  "forkOwned": [
    "packages/gui/**",
    "packages/opencode/src/cli/cmd/tui/**",
    "packages/opencode/src/opencodex/**",
    "packages/opencode/src/server/routes/instance/httpapi/handlers/opencodex.ts",
    "packages/opencode/src/server/routes/instance/httpapi/handlers/opencodex.test.ts",
    "github/**",
    ".github/**",
    "install",
    "install-windows.ps1",
    "script/opencodex-*.ts"
  ],
  "upstreamOwned": [
    "packages/opencode/src/**",
    "packages/opencode/test/**",
    "packages/core/**",
    "packages/llm/**",
    "packages/plugin/**",
    "packages/sdk/js/**",
    "packages/script/**"
  ],
  "sharedSeams": [
    "packages/core/src/database/**",
    "packages/opencode/src/server/**",
    "packages/opencode/src/session/**",
    "packages/opencode/src/provider/**",
    "packages/opencode/src/mcp/**",
    "packages/opencode/src/plugin/**",
    "packages/opencode/src/cli/cmd/github.ts",
    "packages/sdk/js/**",
    "packages/ui/src/components/file-icons/**",
    "packages/ui/src/components/provider-icons/**",
    "package.json",
    "bun.lock"
  ],
  "permanentlyPrunedPaths": [
    "packages/cli",
    "packages/enterprise",
    "packages/function",
    "packages/slack",
    "packages/docs",
    "sdks/vscode",
    "docs/website",
    "containers",
    "identity",
    "extensions",
    "infra",
    "nix",
    "flake.nix",
    "flake.lock",
    "sst.config.ts",
    "sst-env.d.ts",
    "packages/ui/src/assets/icons/file-types",
    "packages/ui/src/assets/icons/provider"
  ],
  "ownedConfiguration": [
    ".github",
    "github/action.yml",
    "github/README.md",
    "packages/opencode/src/cli/cmd/github.ts",
    "packages/opencode/src/installation/index.ts",
    "install",
    "install-windows.ps1",
    "README.md",
    "DEV_README.md",
    "RELEASE_GUIDE.md",
    "SECURITY.md",
    "package.json"
  ],
  "forbiddenOwnedConfigurationText": [
    "anomalyco/opencode/github",
    "social-cards.sst.dev",
    "discord.gg/opencode",
    "github.com/sst/opencode",
    "opencodex/opencodex"
  ]
}
