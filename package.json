{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencodex",
  "description": "Terminal-native multi-session fork of opencode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run script/opencodex-dev.ts",
    "dev:tui": "bun run script/opencodex-dev.ts",
    "dev:electron": "bun --cwd packages/gui run dev:electron",
    "opencodex": "bun run script/opencodex-dev.ts",
    "lint": "oxlint",
    "lint:ci": "bun run script/check-lint-baseline.ts",
    "test:ci": "bun run script/check-ci-tasks.ts && bun run script/check-legacy-session-sync.ts && bun run script/check-client-state-boundary.ts && bun turbo test:ci",
    "check:client-state": "bun run script/check-client-state-boundary.ts",
    "check:legacy-sync": "bun run script/check-legacy-session-sync.ts",
    "check:quick": "bun turbo typecheck test:ci --filter=...[origin/main]",
    "surface:audit": "bun run script/check-retained-surface.ts",
    "upstream:status": "bun run script/upstream-status.ts",
    "upstream:rehearse": "bun run script/upstream-rehearse.ts",
    "graph:update": "graphify . --update",
    "typecheck": "bun run turbo typecheck",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/opencode fix-node-pty",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/opencode",
      "packages/core",
      "packages/gui",
      "packages/sdk/js",
      "packages/ui",
      "packages/plugin",
      "packages/llm",
      "packages/script",
      "packages/effect-drizzle-sqlite",
      "packages/effect-sqlite-node",
      "packages/http-recorder",
      "github"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.66",
      "@effect/platform-node": "4.0.0-beta.66",
      "@effect/sql-sqlite-bun": "4.0.0-beta.66",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@opentui/core": "0.3.0",
      "@opentui/keymap": "0.3.0",
      "@opentui/solid": "0.3.0",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.1.0-beta.18",
      "opentui-spinner": "0.0.6",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.66",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "@playwright/test": "1.59.1",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.49.1",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "turbo": "2.8.13"
  },
  "dependencies": {
    "@opencode-ai/plugin": "workspace:*",
    "@opencode-ai/script": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ecgreen/OpencodeX"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "@npmcli/agent@4.0.0": "patches/@npmcli%2Fagent@4.0.0.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch",
    "virtua@0.49.1": "patches/virtua@0.49.1.patch",
    "@opentui/solid@0.3.0": "patches/@opentui%2Fsolid@0.3.0.patch",
    "@ai-sdk/xai@3.0.82": "patches/@ai-sdk%2Fxai@3.0.82.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch"
  }
}
