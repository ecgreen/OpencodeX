{
  "name": "@opencode-ai/ui",
  "version": "1.15.13",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/components/*.tsx",
    "./session-diff": "./src/components/session-diff.ts",
    "./tool-output-preview": "./src/components/tool-output-preview.ts",
    "./pierre": "./src/pierre/index.ts",
