    "./audio/*": "./src/assets/audio/*",
    "./v2/*": "./src/v2/*",
    "./v2/components/*": "./src/v2/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test src",
    "test:ci": "mkdir -p .artifacts/unit && bun test src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
